{
  "name": "eiriksm.dev",
  "version": "1.0.0",
  "description": "The website for eiriksm.dev - Next.js Blog",
  "author": "Eirik S. Morland <eirik@morland.no>",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "deploy": "aws s3 sync out/ s3://eiriksm.dev --delete --cache-control 'public,max-age=31536000,immutable' --exclude '*.html' && aws s3 sync out/ s3://eiriksm.dev --delete --cache-control 'public,max-age=0,must-revalidate' --exclude '*' --include '*.html'"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "date-fns": "^4.1.0",
    "drupal-jsonapi-params": "^3.0.0",
    "next": "^16.0.10",
    "next-drupal": "^1.6.0",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.0.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
