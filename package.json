{
  "name": "eiriksm.dev",
  "version": "1.0.0",
  "description": "The website for eiriksm.dev - Astro Blog",
  "author": "Eirik S. Morland <eirik@morland.no>",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check && tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,astro}\"",
    "test": "vitest run",
    "unit": "npm run test",
    "test:watch": "vitest",
    "deploy": "aws s3 sync dist/ s3://eiriksm.dev --delete --cache-control 'public,max-age=31536000,immutable' --exclude '*.html' && aws s3 sync dist/ s3://eiriksm.dev --delete --cache-control 'public,max-age=0,must-revalidate' --exclude '*' --include '*.html'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^6.0.0-beta",
    "date-fns": "^4.1.0",
    "drupal-jsonapi-params": "^3.0.0",
    "fast-xml-parser": "^5.3.3",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "marked": "^17.0.1",
    "node-emoji": "^2.2.0",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
